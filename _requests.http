@Host=http://localhost:3000

GET {{Host}}/


###
# obtener todas las tareas
GET {{Host}}/tareas/

###
# crear tarea
POST {{Host}}/tareas/
Content-Type: application/json

{
    "nombre": "Comer 🍚"
}


