###
# obtener tarea x id
GET {{Host}}/tareas/4

###
# delete x id
DELETE {{Host}}/tareas/2

###
# editar tarea x id
PATCH  {{Host}}/tareas/patch/edit/4
Content-Type: application/json

{
    
    "nombre": "Celebrar 🎆🎈"
}

###
# editar tarea status completado
PUT {{Host}}/tareas/5/completado

###
# editar tarea status no completado
PUT {{Host}}/tareas/5/no-completado